---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const blogPosts = await getCollection('blog');

// Sort blog posts by date if present
const sortedBlogPosts = blogPosts.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});
---

<Layout title="Shahar Bareket">
  <header class="flex flex-row">
    <h1 class="text-[62px] leading-[35px]">
      <span class="font-[200] text-[48px]">Shahar</span>
      <br>
      <b class="font-[400] text-[48px]">Bareket</b>
    </h1>
    <img src="/img/mobile-dino.svg" alt="mobile-dino" width="91" height="91" loading="eager" class="mt-[8px]">
    
    <iframe src="/trex.html" title="trex game" frameborder="0" scrolling="no" width="100%" height="100%" loading="lazy"></iframe>
    <style type="text/css">iframe { position: relative; margin-top: -32px; margin-bottom: -10px;}</style>
  </header>

  <main id="about">
    <h2 class="text-[24px] font-[600] ml-[2px]">
      About Me
    </h2>
    
    <hr class="my-[8px] text-[#3A3A3A] border-dashed border-t-[2px]">
    
    <div id="content">
      <b>Hi </b>, I’m Shahar 👋 <br>
      <b>I build things—</b> mostly with code, but also by shaping ideas into real products. As a software developer and maker, I love turning concepts into functional, user-friendly solutions. Whether it’s crafting sleek web applications, launching new projects, or experimenting with innovative ideas, I’m always up for a challenge.
      <br>
      <br>
      Check out my projects below, and if you want to chat, feel free to reach out! 🚀
    </div>
  </main>

  <section id="projects">
    <h2 class="text-[24px] font-[600] ml-[2px] mb-[4px]">
      Projects
    </h2>

    <hr class="my-[16px] text-[#3A3A3A] border-dashed border-t-[2px]">

    <div class="flex gap-[16px] justify-between flex-wrap">
      {projects.map((project) => (
        <ProjectCard
          id={project.id}
          title={project.data.title}
          text={project.data.text}
          img={project.data.img}
        />
      ))}
    </div>
  </section>

  <section id="blog">
    <h2 class="text-[24px] font-[600] ml-[2px] mb-[4px]">
      Blog & Rumblings
    </h2>

    <hr class="my-[16px] text-[#3A3A3A] border-dashed border-t-[2px]">

    <ul class="flex flex-col gap-[20px]">
      {sortedBlogPosts.map((post) => (
        <li class="hover:bg-[#0000003a] p-1 rounded-[8px] transition-all duration-300">
          <a href={post.data.url || `/blog/${post.slug}`}>
            <article class="cursor-pointer m:flex">
              {post.data.img && (
                <img 
                  src={post.data.img} 
                  class="rounded-[4px] w-full m:w-[160px] m:h-[100px] !min-h-[100px] !min-w-[160px] max-w-[312px] max-h-[195px] object-cover" 
                  alt={post.data.title} 
                  loading="lazy" 
                  width="312" 
                  height="195"
                />
              )}
              <div class="p-2 sm:pt-0">
                <h3 class="text-[18px] font-bold">{post.data.title}</h3>
                <p class="text-[16px]">
                  {post.data.excerpt}
                </p>
              </div>
            </article>
          </a>
        </li>
      ))}
    </ul>

    <div class="flex justify-end mt-2">
      <a href="https://blog.bareket.co" class="bg-[#000] p-[2px_6px] hover:underline text-[14px] font-mono">To The full Blog ← </a>
    </div>
  </section>

  <ContactForm id="contact" />

  <footer class="text-center">
    <hr class="my-[16px] text-[#3A3A3A] border-dashed border-t-[2px]">
    <p>© 2025 all rights reserved to Shahar bareket</p>
  </footer>
</Layout>
